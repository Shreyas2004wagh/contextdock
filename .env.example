# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# Cognee Platform / Cloud
# COGNEE_API_BASE_URL=https://tenant-xxxx.aws.cognee.ai
# COGNEE_API_KEY=your-cognee-platform-key
# COGNEE_TENANT_ID=your-tenant-id

# Cognee/LLM provider config.
# Fill the provider values required by your Cognee setup.
ENABLE_BACKEND_ACCESS_CONTROL=false

# OAuth providers
# For production on Vercel + Render, set:
# FRONTEND_URL=https://cognee-project.vercel.app
# OAUTH_REDIRECT_BASE_URL=https://cogneeproject.onrender.com
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_SECURE=true
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Fill the provider values required by your Cognee setup.
# Example:
# OPENAI_API_KEY=sk-...
